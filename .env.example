# Same provider/key as the Big-5 ingestion — World Cup is a different product line, same account.
BALLDONTLIE_KEY=

# Pin explicitly even though the API defaults to 2026 when omitted — don't rely on the default.
WC_SEASON=2026
WC_API_BASE=https://api.balldontlie.io

# Where ingestion scripts write static output. Mirrors the scout/public convention.
WC_OUTPUT_DIR=scout/public/worldcup

# Only needed if you build the live-polling proxy — otherwise leave unset.
WC_LIVE_POLL_INTERVAL_MS=60000
